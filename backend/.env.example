# ---------------------------------------------------------------------------
# Copier ce fichier en .env et renseigner les valeurs.
# .env contient des secrets : il ne doit JAMAIS etre commite (ignore par git).
# Les autres reglages ont une valeur par defaut (voir le tableau du README) ;
# en production, definir aussi SPRING_PROFILES_ACTIVE=prod, APP_FRONTEND_URL
# et APP_CORS_ALLOWED_ORIGINS.
# ---------------------------------------------------------------------------

# --- Base de donnees PostgreSQL ---
# La base doit exister ; les tables sont creees au demarrage (schema.sql).
DB_URL=jdbc:postgresql://localhost:5432/oravisit
DB_USERNAME=postgres
DB_PASSWORD=

# --- Jeton de connexion ---
# Secret HS256 encode en Base64 (32 octets minimum). Obligatoire en production.
# Generation : openssl rand -base64 48
APP_JWT_SECRET=

# --- E-mails : liens de definition du mot de passe ---
# Exemple Gmail : mot de passe d'application (16 caracteres, sans espaces) cree sur
# https://myaccount.google.com/apppasswords apres activation de la validation en deux etapes.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=votre.adresse@gmail.com
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
APP_MAIL_FROM=OraVisit <votre.adresse@gmail.com>

# En profil dev, une copie de chaque e-mail est deposee dans Mailpit pour en voir
# le rendu (http://localhost:8025). Valeurs par defaut :
# APP_MAIL_PREVIEW_HOST=localhost
# APP_MAIL_PREVIEW_PORT=1025
